    "Close without saving": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不保存并关闭"
          }
        }
      }
    },
    "Compare": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "比较"
          }
        }
      }
    },
    "Compare shows the things you said you care about. You haven't chosen any yet.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\"比较\"只比你说在意的事。你还没有选。"
          }
        }
      }
    },
    "Compass ±%lld°": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "罗盘 ±%lld°"
          }
        }
      }
    },
    "Could not start the microphone: %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没能启动麦克风：%@"
          }
        }
      }
    },
    "Couldn't %@ iCloud at %@: %@. Your records are safe on this device and the app keeps trying.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Couldn't %1$@ iCloud at %2$@: %3$@. Your records are safe on this device and the app keeps trying."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ iCloud 在 %@ 失败：%@。记录在这台设备上是安全的，App 会继续尝试。"
          }
        }
      }
    },
    "Couldn't add it to the property yet (%@). It's kept on this device and is added the next time the app opens.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没能加到这套房上（%@）。它保存在这台设备上，下次打开 App 时会加上。"
          }
        }
      }
    },
    "Couldn't check the iCloud account. Your records are on this device.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没能检查 iCloud 账户。记录在这台设备上。"
          }
        }
      }
    },
    "Couldn't close the inspection: %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没能结束这次看房：%@"
          }
        }
      }
    },
    "Couldn't delete": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没能删除"
          }
        }
      }
    },
    "Couldn't delete everything": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没能全部删除"
          }
        }
      }
    },
    "Couldn't find this address on the map. Check the spelling or add the suburb, or save it without a pin and place it later from the property page.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "地图上找不到这个地址。检查拼写或加上区名，或者先不定位保存，之后在房产页里再放图钉。"
          }
        }
      }
    },
    "Couldn't find this address on the map. Check the spelling or add the suburb, or save it without a pin.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "地图上找不到这个地址。检查拼写或加上区名，或者不定位保存。"
          }
        }
      }
    },
    "Couldn't find where you are": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "找不到你的位置"
          }
        }
      }
    },
    "Couldn't move older files into the library yet: %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没能把旧文件移入资料库：%@"
          }
        }
      }
    },
    "Couldn't reach Apple Maps. You can still save the address as you typed it.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连不上 Apple 地图。你仍可以按输入的原样保存。"
          }
        }
      }
    },
    "Couldn't remove it": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没能移除"
          }
        }
      }
    },
