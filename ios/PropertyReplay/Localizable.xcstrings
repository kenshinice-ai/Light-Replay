      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选一套房"
          }
        }
      }
    },
    "Choose up to three.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最多选三套。"
          }
        }
      }
    },
    "Choose what you care about": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择你在意的事"
          }
        }
      }
