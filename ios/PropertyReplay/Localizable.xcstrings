{
  "sourceLanguage": "en",
  "strings": {
    "": {
      "shouldTranslate": false
    },
    "%@ It is hidden now and will be removed the next time the library saves.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 它现在已隐藏，下次资料库保存时会被移除。"
          }
        }
      }
    },
    "%@%@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@%2$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@%@"
          }
        }
      }
    },
    "%@, %@: %@%@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@, %2$@: %3$@%4$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@，%@：%@%@"
          }
        }
      }
    },
    "%@, approximate": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@，近似"
          }
        }
      }
    },
    "%@, compass within about %lld°": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@, compass within about %2$lld°"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@，罗盘误差约 %lld°"
          }
        }
      }
    },
    "%lld measurement(s) are waiting for a property that no longer exists.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 条测量在等待一套已不存在的房产。"
          }
        }
      }
    },
    "%lld of %lld homes match.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$lld of %2$lld homes match."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 套符合，共 %lld 套。"
          }
        }
      }
    },
    "%lld of %lld on the map. %lld need a pin: see the list.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$lld of %2$lld on the map. %3$lld need a pin: see the list."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "地图上有 %lld 套，共 %lld 套。%lld 套还没有定位：请看列表。"
          }
        }
      }
    },
    "%lld percent": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "百分之 %lld"
          }
        }
      }
    },
    "%lld recorded": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已记录 %lld 条"
          }
        }
      }
    },
    "%lld%% of the %@ path": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$lld%% of the %2$@ path"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld路径的 %@%%"
          }
        }
      }
    },
    ". Anything recorded since may still be on its way.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "。此后记录的内容可能还在路上。"
          }
        }
      }
    },
    "A fact you confirmed, or licensed data with a source.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你确认过的事实，或有来源的授权数据。"
          }
        }
      }
    },
    "A model's estimate. Worth verifying.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "模型的估计。值得核实。"
          }
        }
      }
    },
    "A note here counts under %@ for %@.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "A note here counts under %1$@ for %2$@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在这里写的笔记会计入 %@ 的\"%@\"。"
          }
        }
      }
    },
    "ARSession: %@": {
      "shouldTranslate": false
    },
    "About": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关于什么"
          }
        }
      }
    },
    "Add": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加"
          }
        }
      }
    },
    "Add a caption": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "加一句说明"
          }
        }
      }
    },
    "Add a note": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "写笔记"
          }
        }
      }
    },
    "Add a note about this": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为这一项写笔记"
          }
        }
      }
    },
    "Add a property": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加房产"
          }
        }
      }
    },
    "Add a property first": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先添加一套房产"
          }
        }
      }
    },
    "Add properties first, in the Properties tab.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先在\"房产\"里添加房子。"
          }
        }
      }
    },
    "Add property": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加房产"
          }
        }
      }
    },
    "Add sample properties (fictional)": {
      "shouldTranslate": false
    },
    "Add test note (simulator)": {
      "shouldTranslate": false
    },
    "Add test photo (simulator)": {
      "shouldTranslate": false
    },
    "Add the homes you plan to inspect. If you already use Property Replay on another device, your homes arrive here once iCloud catches up; that can take a few minutes.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把准备去看的房子加进来。如果你在另一台设备上用过 Property Replay，等 iCloud 同步完成，房子就会出现在这里，可能需要几分钟。"
          }
        }
      }
    },
    "Add the homes you plan to inspect. They stay on this device.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把准备去看的房子加进来。它们只保存在这台设备上。"
          }
        }
      }
    },
    "Added %lld measurement(s) that weren't saved last time.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "补上了 %lld 条上次没保存的测量。"
          }
        }
      }
    },
    "Address": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "地址"
          }
        }
      }
    },
    "Address or suburb": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "地址或区名"
          }
        }
      }
    },
    "Addresses go to Apple Maps only to place a pin. Properties, photos, notes and measurements stay on this device and, with iCloud sync on, in your private iCloud so your iPad sees them too. No one else, including us, can read them. Nothing else is uploaded unless you share a page.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "地址只发给 Apple 地图用来放图钉。房产、照片、笔记和测量都留在这台设备上；开了 iCloud 同步，也会在你的私人 iCloud 里，这样 iPad 上也能看到。没有别人能读到它们，包括我们。除非你主动分享，不会上传任何其他内容。"
          }
        }
      }
    },
    "All %lld recorded": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "全部 %lld 条记录"
          }
        }
      }
    },
    "All statuses": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "全部状态"
          }
        }
      }
    },
    "All-year sun": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "全年阳光"
          }
        }
      }
