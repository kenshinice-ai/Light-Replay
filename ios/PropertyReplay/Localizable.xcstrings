    "Camera access is off. Enable it in Settings to capture photos.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "相机权限已关闭。到\"设置\"里打开才能拍照。"
          }
        }
      }
    },
    "Camera covered": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "镜头覆盖"
          }
        }
      }
