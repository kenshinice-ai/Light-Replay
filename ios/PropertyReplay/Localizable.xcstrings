      }
    },
    "Couldn't save: %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没能保存：%@"
          }
        }
      }
    },
    "Couldn't save: %@. Nothing was added; try again.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没能保存：%@。什么都没有加进来，请再试一次。"
