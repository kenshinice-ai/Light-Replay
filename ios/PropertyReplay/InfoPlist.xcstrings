{
  "sourceLanguage": "en",
  "strings": {
    "CFBundleDisplayName": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Property Replay"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Property Replay"
          }
        }
      }
    },
    "NSCameraUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Property Replay uses the camera to capture what you see during an inspection and to measure how much direct sun reaches the spot where you are standing."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Property Replay 用相机记录你看房时看到的东西，并测量你所站位置能照到多少直射阳光。"
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your location sets where the sun is in the sky for this property. It stays with your records on this device and in your private iCloud."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的位置决定这套房的太阳在天空中的位置。它和你的记录一起留在这台设备和你的私人 iCloud 里。"
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold to dictate a note. Audio is transcribed on this device and not stored."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按住口述笔记。语音在这台设备上转写，不会保存。"
          }
        }
      }
    },
    "NSMotionUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Device motion keeps the sky scan aligned while you turn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备运动数据让你转身时天空扫描保持对齐。"
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notes you dictate are transcribed on this device. No audio is stored."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你口述的笔记在这台设备上转写。不会保存任何音频。"
          }
        }
      }
    }
  },
  "version": "1.0"
}